{
  "name": "file-tree",
  "displayName": "File Tree",
  "version": "0.2.3",
  "icon": "./assets/icon.png",
  "description": "A project file tree pane inside Claude Code, the same in every terminal.",
  "author": {
    "name": "Kamal Raydan"
  },
  "homepage": "https://github.com/Aristere/termichy",
  "repository": "https://github.com/Aristere/termichy",
  "documentationUrl": "https://github.com/Aristere/termichy#readme",
  "supportUrl": "https://github.com/Aristere/termichy/issues",
  "license": "MIT",
  "keywords": [
    "file-tree",
    "files",
    "pane",
    "preview",
    "mod"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "width": {
      "type": "number",
      "title": "Pane width",
      "description": "Columns the pane asks the dock for",
      "default": 56,
      "min": 30,
      "max": 120
    },
    "openOnStart": {
      "type": "boolean",
      "title": "Open on session start",
      "description": "Show the file tree when a session starts",
      "default": false
    }
  }
}
